# ---------------------------------------------------------------------------
# Example env for the Next.js frontend (local dev).
# Copy to `frontend/.env.local`. NEVER commit the real file.
# ---------------------------------------------------------------------------

# Backend REST base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/notifications

# VAPID public key (must match the backend's VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
