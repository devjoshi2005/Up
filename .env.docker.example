# ---------------------------------------------------------------------------
# Example env for the local Docker stack (docker-compose.yml).
# Copy to `.env.docker` and fill in real values. NEVER commit the real file.
#
#   cp .env.docker.example .env.docker
#
# `DB_*`/`REDIS_*` point at the compose services, so they are not secrets.
# `BREVO_API_KEY`, `TEXTLINK_API_KEY`, `VAPID_*` and `HMAC_SECRET_KEY`
# ARE secrets — generate/obtain your own.
# ---------------------------------------------------------------------------

# ---- Django ----
DJANGO_SECRET_KEY=replace-with-50-random-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
PUBLIC_BASE_URL=http://localhost:8000
ACK_TOKEN_TTL_SECONDS=86400
HMAC_SECRET_KEY=replace-with-50-random-chars

# ---- Postgres (the `postgres` compose service) ----
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
# Under ASGI each sync request runs in its own thread and therefore holds its
# own connection; reuse (CONN_MAX_AGE>0) piles up idle connections. Use a
# pooler (PgBouncer) in production instead of relying on this.
DB_CONN_MAX_AGE=0

# ---- Redis (the `redis` compose service) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Email ----
# brevo (real) | smtp (local Mailpit) | mock (no network — use for load tests)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@example.com
BREVO_SENDER_NAME=Up
BREVO_EMAIL=
BREVO_DAILY_QUOTA=300

# ---- SMS: textlink (real) | mock (no network — use for load tests) ----
SMS_PROVIDER=textlink
TEXTLINK_API_KEY=
TEXTLINK_DEST=

# ---- Web push (VAPID) — generate with: python -m py_vapid ... ----
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# ---- Load-test tuning ----
# Raise the per-tenant ingest throttle so k6 is not throttled. Leave at the
# default (600/min) in production.
THROTTLE_TENANT_RATE=100000/min
# Number of Gunicorn+Uvicorn workers (4 is right for a 2 vCPU instance).
GUNICORN_WORKERS=4
