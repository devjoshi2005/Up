# ---------------------------------------------------------------------------
# Example env for running the backend directly (no Docker).
# Copy to `backend/.env` and fill in real values. NEVER commit the real file.
#
#   cp backend/.env.example backend/.env
#
# Placeholders only — do not paste real credentials into this file.
# ---------------------------------------------------------------------------

# ---- Django ----
DJANGO_SECRET_KEY=replace-with-50-random-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
ACK_TOKEN_TTL_SECONDS=86400
HMAC_SECRET_KEY=replace-with-50-random-chars

# ---- Postgres (e.g. Supabase pooler in production, local Postgres in dev) ----
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# ---- Redis (e.g. Upstash in production) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Email: brevo (real) | smtp (Mailpit) | mock (no network) ----
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@example.com
BREVO_SENDER_NAME=Up
BREVO_EMAIL=
BREVO_DAILY_QUOTA=300

# ---- SMS: textlink (real) | mock (no network) ----
SMS_PROVIDER=mock
TEXTLINK_API_KEY=
TEXTLINK_DEST=

# ---- Web push (VAPID) ----
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# ---- Throttling ----
THROTTLE_TENANT_RATE=600/min
